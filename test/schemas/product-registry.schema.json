{
  "type": "object",
  "required": [
    "contract",
    "stages",
    "kinds"
  ],
  "properties": {
    "contract": {
      "type": "number",
      "const": 1,
      "description": "The contract version the registry is written against; this schema publishes version 1."
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "The life cycle in the order the reader walks it; every kind names one of these."
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "prefix",
          "folder",
          "stage",
          "hint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Two to four capitals (A-Z), checked when the registry is read."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "A place under docs/, like docs/requirements; checked when the registry is read."
          },
          "stage": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
              "minLength": 1
            },
            "minItems": 1,
            "description": "The statuses the kind's documents may carry; a document's status outside the list is a finding on its page."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "targets"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                  "minLength": 1
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "description": "Each target names a kind of the registry by its id prefix; checked when the registry is read."
                },
                "backlink": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
                  "minLength": 1
                },
                "cardinality": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "one"
                    },
                    {
                      "type": "string",
                      "const": "many"
                    }
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "description": "The link fields the kind's documents carry, each naming its allowed target kinds."
          }
        },
        "additionalProperties": false
      },
      "description": "The kinds the product holds, each naming its stage of the list."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shady2k/madarch/schema/v1/product-registry.schema.json",
  "title": "Madarch product kinds registry",
  "description": "The shape of one product repository kinds registry file, at contract version 1: the stages as an ordered list with no fixed kinds, and the kinds the product holds, each with its name, id prefix, folder, stage, next-step hint, allowed statuses and declared link types. The mechanism is madarch's; the kinds (usually written at setup by the skill set) are the product's data.",
  "additionalProperties": false
}
